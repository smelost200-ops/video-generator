# Скопируйте файл под именем .env и подставьте свои значения.
# Ключи НЕ отправляются на GitHub: .env есть в .gitignore.
API_KEY=...ваш_ключ_ProxyAPI...
BOT_TOKEN=...токен_бота_от_BotFather...

# Необязательные настройки (значения по умолчанию уже в коде):
VIDEO_MODEL=x-ai/grok-imagine-video-1.5-lite
VIDEO_DURATION=4
VIDEO_RESOLUTION=720p
VIDEO_ASPECT=1:1
